# Serve auto-detects a live provider. Pin one when more than one is configured;
# an explicit pin fails closed instead of falling back to another provider.
# HARNESS_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# HARNESS_MODEL=gpt-oss:20b

# Ollama Cloud
# HARNESS_PROVIDER=ollama-cloud
# OLLAMA_API_KEY=
# HARNESS_MODEL=gpt-oss:120b

# OpenAI
# HARNESS_PROVIDER=openai
# OPENAI_API_KEY=
# HARNESS_MODEL=gpt-5.6-luna
# HARNESS_REASONING=xhigh

# xAI
# HARNESS_PROVIDER=xai
# XAI_API_KEY=
# HARNESS_MODEL=grok-4.6

# Optional OpenAI-compatible endpoint override for the selected provider.
# HARNESS_API_BASE=
