# One engine runs the work. Pin it with HARNESS_PROVIDER, or leave it unset and the
# first key below wins, in this order: claude, codex, openrouter.

# Anthropic Messages API on the harness tools. Select an explicit model ID.
# HARNESS_PROVIDER=claude
# ANTHROPIC_API_KEY=
# HARNESS_MODEL=your-claude-model-id

# Codex, via the Codex SDK. CODEX_API_KEY also works.
# HARNESS_PROVIDER=codex
# OPENAI_API_KEY=

# Every other model (Grok, DeepSeek, Qwen, Llama, ...) through OpenRouter.
# HARNESS_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# HARNESS_MODEL=qwen/qwen3-coder
# HARNESS_REASONING=high

# Claude and OpenRouter require an explicit model. Codex can use its vendor default.
# HARNESS_MODEL=

# Prefer cross-vendor review. Anthropic-only runs use a fresh read-only Claude context.
# Claude review of another vendor requires an explicit HARNESS_REVIEWER_MODEL.
# Override the reviewer or select software-only review:
# HARNESS_REVIEWER=claude | codex | none
# HARNESS_REVIEWER_MODEL=
